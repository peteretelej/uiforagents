{
  "schemaVersion": "1.0.0",
  "name": "toast",
  "type": "registry:component",
  "category": "feedback",
  "title": "Toast",
  "description": "Bottom-center transient message with show/hide transition and info, ok, warn, danger flavors.",
  "keywords": ["toast", "notification", "snackbar", "status", "transient"],
  "behavior": "js-inline",
  "cssVars": [
    "--uifa-accent-soft",
    "--uifa-accent",
    "--uifa-ok-soft",
    "--uifa-ok",
    "--uifa-warn-soft",
    "--uifa-warn",
    "--uifa-danger-soft",
    "--uifa-danger",
    "--uifa-surface",
    "--uifa-border",
    "--uifa-border-strong",
    "--uifa-border-width",
    "--uifa-text",
    "--uifa-radius-control",
    "--uifa-shadow-char",
    "--uifa-font-body",
    "--uifa-text-base",
    "--uifa-space",
    "--uifa-duration",
    "--uifa-ease"
  ],
  "variants": [
    { "name": "info", "default": true, "description": "Neutral confirmation such as a saved draft." },
    { "name": "ok", "description": "Success completion." },
    { "name": "warn", "description": "Recoverable problem." },
    { "name": "danger", "description": "Failure that needs user action." }
  ],
  "files": [
    { "path": "toast.html", "type": "kit:markup" },
    { "path": "toast.css", "type": "kit:style" },
    { "path": "toast.js", "type": "kit:behavior" },
    { "path": "toast.example.html", "type": "kit:example" },
    { "path": "fixture.aria.yml", "type": "kit:fixture" }
  ],
  "docs": "The region is fixed bottom-center; keep one region per page and stack toasts inside it. `role=\"status\"` announces messages politely. Drive visibility with `data-state=\"visible|hidden\"`; the script wires the trigger, auto-hide after 4s, and manual dismissal.",
  "meta": { "source": "original" }
}
