{
  "schemaVersion": "2.0.0",
  "name": "modal",
  "type": "registry:component",
  "category": "overlay",
  "title": "Modal",
  "description": "Native dialog: centered card on desktop, bottom sheet on small screens, scrim via token.",
  "keywords": ["modal", "dialog", "overlay", "confirm", "sheet"],
  "behavior": {
    "kind": "js-inline",
    "contract": [
      "data-uifa-slot=\"open\" click calls dialog.showModal()",
      "data-uifa-slot=\"cancel\" and data-uifa-slot=\"confirm\" click call dialog.close()"
    ],
    "packages": []
  },
  "cssVars": [
    "--uifa-surface",
    "--uifa-border",
    "--uifa-border-strong",
    "--uifa-border-width",
    "--uifa-text",
    "--uifa-text-muted",
    "--uifa-accent",
    "--uifa-accent-fg",
    "--uifa-accent-soft",
    "--uifa-danger",
    "--uifa-danger-fg",
    "--uifa-scrim",
    "--uifa-radius-control",
    "--uifa-shadow-char",
    "--uifa-font-display",
    "--uifa-font-body",
    "--uifa-text-base",
    "--uifa-space",
    "--uifa-duration",
    "--uifa-ease"
  ],
  "variants": [],
  "props": [],
  "slots": [
    { "name": "open", "description": "Trigger that opens the dialog." },
    { "name": "title", "description": "Dialog heading." },
    { "name": "body", "description": "Dialog copy." },
    { "name": "actions", "description": "Footer action cluster." },
    { "name": "cancel", "description": "Dismiss action." },
    { "name": "confirm", "description": "Primary action; danger styling for destructive flows." }
  ],
  "files": [
    { "path": "modal.html", "type": "kit:markup" },
    { "path": "modal.css", "type": "kit:style" },
    { "path": "modal.js", "type": "kit:behavior" },
    { "path": "modal.example.html", "type": "kit:example" },
    { "path": "fixture.aria.yml", "type": "kit:fixture" }
  ],
  "docs": "Built on the native `<dialog>`: `showModal()` provides the focus trap, Esc to close, and the top layer; `::backdrop` reads `--uifa-scrim`. Confirm actions use `data-uifa-variant=\"danger\"` for destructive flows. Below 480px the card docks to a bottom sheet.",
  "meta": { "source": "original" }
}
